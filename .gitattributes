# Normalize all text files to LF in the repository.
# Fixes the CRLF churn introduced by the ruff format pass on Windows, which made
# the refactor diff ~5x larger than its real content.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe can mis-parse them.
*.bat text eol=crlf

# Binaries: never touch.
*.pth binary
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.tif binary
*.pyc binary
*.zip binary
